# Optional public company-board identifiers; these are not credentials.
GREENHOUSE_BOARD_TOKENS=stripe,figma,gitlab,cloudflare,databricks
LEVER_SITE_NAMES=mindtickle,meesho,cred
APP_ENV=development

# For local development use the default. In Docker, use the backend service name,
# for example: http://backend:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_HOST=127.0.0.1
